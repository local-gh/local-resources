events {
    worker_connections 1024;
}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Prefer proto from the load balancer (https after DO TLS termination).
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    # Skip HTTP→HTTPS redirect for local development hosts.
    map $host $is_localhost {
        default 0;
        localhost 1;
        127.0.0.1 1;
        ~*\.localhost$ 1;
    }

    # Redirect only when the original client request was HTTP (not localhost).
    # Behind the DO LB, HTTPS clients arrive as HTTP with X-Forwarded-Proto: https.
    map "$forwarded_proto:$is_localhost" $redirect_to_https {
        default 0;
        "http:0" 1;
    }

    $NGINX_CORE_HTTP_CONFIG
    $NGINX_ECOMMERCE_HTTP_CONFIG
    $NGINX_AI_HTTP_CONFIG
    $NGINX_BLOG_HTTP_CONFIG
    $NGINX_S3_HTTP_CONFIG
}

stream {
    $NGINX_CORE_STREAM_CONFIG
    $NGINX_ECOMMERCE_STREAM_CONFIG
}
