events {
    worker_connections 1024;
}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Skip HTTP→HTTPS redirect for local development hosts.
    map $host $is_localhost {
        default 0;
        localhost 1;
        127.0.0.1 1;
        ~*\.localhost$ 1;
    }

    map "$scheme:$is_localhost" $redirect_to_https {
        default 0;
        "http:0" 1;
    }

    # TLS material copied onto the nginx SSL volume (setup_ssl.sh / kubectl_setup_nginx.sh).
    ssl_certificate     /etc/ssl/root.crt;
    ssl_certificate_key /etc/ssl/root.key;
    ssl_password_file   /etc/ssl/root.pass;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    $NGINX_CORE_HTTP_CONFIG
    $NGINX_ECOMMERCE_HTTP_CONFIG
    $NGINX_AI_HTTP_CONFIG
    $NGINX_BLOG_HTTP_CONFIG
}

stream {
    $NGINX_CORE_STREAM_CONFIG
    $NGINX_ECOMMERCE_STREAM_CONFIG
}
